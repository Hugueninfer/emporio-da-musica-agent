# Copie para .env e preencha. O .env não vai para o git.
ANTHROPIC_API_KEY=

# Modelo do Claude (padrão: claude-sonnet-5-5; mais barato: claude-haiku-4-5)
EMPORIO_MODEL=claude-sonnet-5-5

# Origens liberadas no CORS (o front em dev)
CORS_ORIGINS=http://localhost:3000

# Opcional: fixa o relógio da loja (ISO), útil para reproduzir os exemplos
# STORE_NOW=2026-03-10T10:30
# STORE_TODAY=2026-03-10
